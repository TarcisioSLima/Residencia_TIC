# ============================================================
# Variáveis de ambiente — Stack completa (ETL + Notifications)
# Copiar para .env e preencher os valores reais.
#
# DATABASE_URL e REDIS_URL são injetados pelo docker-compose
# via service name. Não precisam estar aqui para Docker.
# Preencha apenas se for rodar algum módulo fora do Docker.
# ============================================================

ENVIRONMENT=development

# ------------------------------------------------------------
# Frontend (Angular) — build configuration
# ------------------------------------------------------------
# development = usa environment.development.ts (apiUrl http://localhost:8002)
# production  = usa environment.ts (apiUrl do servidor remoto, ex.: http://200.137.215.94:8002)
# Default no docker-compose.yml: development.
# FRONTEND_BUILD_CONFIG=development

# ------------------------------------------------------------
# CORS (módulo usuários / Quarkus prod) — só se a origem do front não estiver no padrão do JAR
# ------------------------------------------------------------
# QUARKUS_HTTP_CORS_ORIGINS=http://meu-front:4200,https://meu-dominio.br
# (lista separada por vírgula, sem espaços)

# ------------------------------------------------------------
# Postgres (interpolação do docker-compose.yml: db, modulo_usuarios, ETL, notifications)
# ------------------------------------------------------------
# POSTGRES_USER=cempa
# POSTGRES_PASSWORD=j5fwuyqnoe
# POSTGRES_DB=sigedam
# Se a senha do usuário não bater com o volume, use: make clean && make up (apaga dados locais).

# ------------------------------------------------------------
# ETL
# ------------------------------------------------------------
METEOGRAM_BASE_URL=https://tatu.cempa.ufg.br/HST_Meteogramas/
METEOGRAM_BASE_PATH=tmp/meteograms
MIN_FILE_SIZE_BYTES=100
HTTP_TIMEOUT=30
CELERY_RETRY_BACKOFF_MAX=60
CELERY_MAX_RETRIES=3
ETL_SCHEDULE_HOUR=6
ETL_SCHEDULE_MINUTE=0

# ------------------------------------------------------------
# Notifications — WhatsApp (Z-API)
# ------------------------------------------------------------
WHATSAPP_INSTANCE=
WHATSAPP_TOKEN=
WHATSAPP_CLIENT_TOKEN=

# ------------------------------------------------------------
# SMTP (Notifications + recuperação de senha no modulo_usuarios)
# ------------------------------------------------------------
# O compose repassa SMTP_* para o Quarkus como MAIL_*.
# Mock (não envia): QUARKUS_MAILER_MOCK=true (padrão se omitido).
# Envio real (ex.: testar recuperação de senha): QUARKUS_MAILER_MOCK=false e preencha SMTP_*.
# Gmail: senha de app sem espaços; em geral MAIL_FROM = mesmo e-mail que SMTP_EMAIL.
QUARKUS_MAILER_MOCK=true
# MAIL_FROM=noreply@sigedam.ufg.br
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ------------------------------------------------------------
# Notifications — Frontend
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:8080

# ------------------------------------------------------------
# Apenas para execução LOCAL fora do Docker
# (dentro do Docker os valores abaixo são ignorados)
# ------------------------------------------------------------
# DATABASE_URL=postgresql://cempa:cempa@localhost:5432/sigedam
# REDIS_URL=redis://localhost:6379/0
